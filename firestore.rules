rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminProfile(id) {
      let p = get(/databases/$(database)/documents/users/$(id)).data;
      return exists(/databases/$(database)/documents/users/$(id)) && p.get('uid','') == request.auth.uid && p.get('role','') == 'admin' &&
        p.get('deleted',false) != true && p.get('mustChangePassword',false) != true && request.auth.token.get('auth_time',0) >= p.get('tokenValidAfterSeconds',0);
    }
    function isAdmin() {
      return signedIn() && (adminProfile('admin') || adminProfile('syhr') || adminProfile('service'));
    }
    function ownProfile(id) {
      let p = get(/databases/$(database)/documents/users/$(id)).data;
      return signedIn() && id != '' && exists(/databases/$(database)/documents/users/$(id)) && !(id in ['admin','syhr','service']) &&
        (p.get('uid','') == request.auth.uid ||
          (p.get('uid','') == '' && request.auth.token.get('email','').lower() == (id + '@shyuan-hrm.com').lower()));
    }
    function activeEmployee(id) {
      let p = get(/databases/$(database)/documents/users/$(id)).data;
      return exists(/databases/$(database)/documents/users/$(id)) && p.get('deleted',false) != true && p.get('mustChangePassword',false) != true && request.auth.token.get('auth_time',0) >= p.get('tokenValidAfterSeconds',0);
    }
    function ownResource() {
      return signedIn() && resource.data.get('uid','') == request.auth.uid &&
        ownProfile(resource.data.get('userId','')) && activeEmployee(resource.data.get('userId',''));
    }
    match /users/{userId} {
      // A reset/archived employee can read only their own profile to see why
      // access is blocked. All business reads and writes remain denied.
      allow read: if isAdmin() || ownProfile(userId);
      allow create: if isAdmin();
      // Keep historical identities; use archive instead of destructive delete.
      allow delete: if false;
      allow update: if isAdmin() || (
        ownProfile(userId) &&
        resource.data.get('deleted',false) != true &&
        resource.data.get('uid','') == '' &&
        request.resource.data.get('uid','') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
      );
    }
    // Validated callable functions are now the only writers of business data.
    // Admin SDK bypasses Rules: authorization/validation lives in the callable.
    match /records/{id} { allow read: if isAdmin() || ownResource(); allow write: if false; }
    match /leaves/{id} { allow read: if isAdmin() || ownResource(); allow write: if false; }
    match /overtimes/{id} { allow read: if isAdmin() || ownResource(); allow write: if false; }
    match /attendance_state/{id} { allow read, write: if false; }
    match /security_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.action is string && request.resource.data.action.size() <= 100 &&
        request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
        request.resource.data.keys().hasOnly(['uid','email','action','details','timestamp','userAgent']);
      allow update, delete: if false;
    }
    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /holidays/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /system/settings {
      allow read: if signedIn();
      allow write: if isAdmin() &&
        request.resource.data.keys().hasOnly(['companyLat','companyLng','allowedRadius']) &&
        request.resource.data.companyLat is number && request.resource.data.companyLat >= -90 && request.resource.data.companyLat <= 90 &&
        request.resource.data.companyLng is number && request.resource.data.companyLng >= -180 && request.resource.data.companyLng <= 180 &&
        !(request.resource.data.companyLat == 0 && request.resource.data.companyLng == 0) &&
        request.resource.data.allowedRadius is number && request.resource.data.allowedRadius > 0 && request.resource.data.allowedRadius <= 20000000;
    }
  }
}
