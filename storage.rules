rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    // Existing synthetic logins and the real service mailbox all map to these
    // existing profile IDs. New upload metadata supports an explicit ID too.
    function accountId() { return request.auth.token.get('email','').lower().split('@')[0]; }
    function activeProfile(id) {
      let p = firestore.get(/databases/(default)/documents/users/$(id)).data;
      return firestore.exists(/databases/(default)/documents/users/$(id)) && p.get('uid','') == request.auth.uid && p.get('deleted',false) != true &&
        p.get('mustChangePassword',false) != true && request.auth.token.get('auth_time',0) >= p.get('tokenValidAfterSeconds',0);
    }
    function isAdmin() {
      let id = accountId();
      return signedIn() && id in ['admin','syhr','service'] && activeProfile(id) &&
        firestore.get(/databases/(default)/documents/users/$(id)).data.get('role','') == 'admin';
    }
    function owner(pathId, profileId) {
      return signedIn() && activeProfile(profileId) &&
        (pathId == request.auth.uid || pathId == profileId);
    }
    match /leave_attachments/{pathId}/{fileName} {
      // Metadata defaults retain access to pre-upgrade attachments, without
      // letting an orphan Auth identity bypass the active profile check.
      allow read: if isAdmin() || owner(pathId,resource.metadata.get('userId',accountId()));
      allow create: if resource == null && owner(pathId,request.resource.metadata.get('userId',accountId())) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType != null &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow update: if false;
      // Employees may clean up their own failed uploads. Administrator
      // attachment removal is handled by the validated callable.
      allow delete: if owner(pathId,resource.metadata.get('userId',accountId()));
    }
  }
}
